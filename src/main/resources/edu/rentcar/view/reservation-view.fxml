<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.rentcar.controller.ReservationController" spacing="12">
    <Label text="Crear una reserva de alquiler" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 8;">
        <GridPane hgap="12" vgap="10">
            <Label text="Cliente" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="customerCombo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="Vehículo" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <ComboBox fx:id="vehicleCombo" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <Label text="Fecha inicio" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <DatePicker fx:id="startDatePicker" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label text="Fecha fin" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <DatePicker fx:id="endDatePicker" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <Label text="Modalidad" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <ComboBox fx:id="modalityCombo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <Label text="Paquete" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
            <ComboBox fx:id="packageCombo" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

            <Label text="Resultado del pago" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <ComboBox fx:id="paymentTokenCombo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            <HBox spacing="12" GridPane.columnIndex="2" GridPane.rowIndex="3" GridPane.columnSpan="2">
                <CheckBox fx:id="gpsCheck" text="GPS"/>
                <CheckBox fx:id="childSeatCheck" text="Silla infantil"/>
                <CheckBox fx:id="extraDriverCheck" text="Conductor extra"/>
            </HBox>
        </GridPane>
        <HBox spacing="10">
            <Button text="Confirmar reserva" onAction="#confirmReservation"
                    style="-fx-background-color: #2457a7; -fx-text-fill: white;"/>
            <Label fx:id="resultLabel" text="Use Aprobado y un cliente autorizado para un alquiler exitoso."
                   wrapText="true" style="-fx-text-fill: #64748b;"/>
        </HBox>
        <Label text="Valentina Torres no está autorizada. Las mismas fechas del mismo vehículo no se pueden confirmar dos veces."
               wrapText="true" style="-fx-text-fill: #64748b;"/>
    </VBox>
    <Label text="Reservas registradas" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
    <TableView fx:id="reservationTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="reservationIdColumn" text="ID" prefWidth="90"/>
            <TableColumn fx:id="reservationCustomerColumn" text="Cliente" prefWidth="140"/>
            <TableColumn fx:id="reservationVehicleColumn" text="Vehículo" prefWidth="130"/>
            <TableColumn fx:id="reservationStartColumn" text="Inicio" prefWidth="90"/>
            <TableColumn fx:id="reservationEndColumn" text="Fin" prefWidth="90"/>
            <TableColumn fx:id="reservationModalityColumn" text="Modalidad" prefWidth="100"/>
            <TableColumn fx:id="reservationTotalColumn" text="Total" prefWidth="90"/>
            <TableColumn fx:id="reservationStatusColumn" text="Estado" prefWidth="100"/>
            <TableColumn fx:id="reservationMessageColumn" text="Mensaje" prefWidth="240"/>
        </columns>
    </TableView>
</VBox>
